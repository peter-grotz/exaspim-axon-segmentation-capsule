#!/usr/bin/env bash
# exaSPIM TRAILMAP axon segmentation — Code Ocean entry point.
#
# Ordered parameters (all optional):
#   1 ASSET          processed exaSPIM asset root
#                    (default: s3://aind-open-data/exaSPIM_851474_2026-07-10_15-23-22_processed_...)
#   2 REGIONS        comma-separated CCF acronyms or IDs                    (default: MD)
#   3 LEVEL          fused.zarr pyramid level                                (default: 2)
#   4 CROP_UM        cube side for a quick diagnostic; 0 = whole region     (default: 0)
#   5 TILE_SIZE      network input side, multiple of 8                      (default: 160)
#   6 BATCH_SIZE     tiles per GPU batch                                    (default: 1)
#   7 WEIGHTS        fine-tuned .safetensors, or a registered name
#                    (default: /data/trailmap_finetune_v2/best.safetensors — attach model asset
#                     52a5d51b-5ba7-4e5a-a923-65e4dd04c359 at mount trailmap_finetune_v2)
#   8 REGION_GROWTH  grow the region by this fraction of its volume         (default: 0.2)
#   9 ANNOTATION     asset with the CCF alignment and soma detections, when they are not in ASSET
#
# Pipeline (exaspim-axon run): segment the grown region → skeletonize, remove debris, connect
# pieces → one SWC per piece → QC figure.
#
# Outputs in /results, with <tag> = <subject>_<regions>_L<level>[_crop<um>]:
#   <tag>_axon_probability.zarr        uint8 axon probability (p × 255), OME-NGFF
#   <tag>_skeleton/swc/<tag>_NNNN.swc  one Horta/Janelia-Workstation SWC per connected piece,
#                                      longest first (µm, # OFFSET/# COLOR headers)
#   <tag>_skeleton/skeleton.swc        all pieces as one SWC forest
#   <tag>_skeleton/skeleton.zarr       skeleton voxels, OME-NGFF
#   <tag>_skeleton/summary.json        settings, lengths, per-piece file list
#   qc/<tag>_skeleton.png              region (atlas + grown outline) with every piece
#   qc/<tag>_region_overlay.png        atlas region on the fused image
#   run.log, pip_list.txt, nvidia_smi.txt, SOURCE_COMMIT   provenance
set -euo pipefail

# First parameter selects the mode; "predict" (default) keeps the ordered parameters below.
#   finetune [STEPS] [MAX_MINUTES] [HOLDOUT_BRAIN] [ENVELOPE_UM]
#            train, then run the pipeline on 851474 MD with the best weights; 822178 MD is labelled only within
#            ENVELOPE_UM (default 50) of its traces, blocks are labelled whole
#   somata [ASSET] [SOMATA] [SIDE_UM] [WEIGHTS]
#            segment and skeletonize a SIDE_UM cube (default 1200) around each soma listed in
#            code/somata/<SOMATA>.csv (name, x_um, y_um, z_um), e.g. traced neurons of one brain
#   expand [ASSET] [MAX_ROUNDS] [MAX_MINUTES] [BUDGET_MM] [ANNOTATION] [WEIGHTS] [TRACER] [SEED]
#            follow MD axon candidates out of MD: segment 800 um cubes ahead of every exit,
#            round after round, until they reach a detected soma, end, or exceed BUDGET_MM
#            (default 100) of path; results in /results/<subject>_expand/. TRACER (default
#            /data/robo_ls_v2_ckpt/best.pt if attached; "none" = geometric only) traces every
#            open end on the image with Robo-LS v2 before cubes are placed. SEED: a probability.zarr
#            from an earlier expand run of the same asset (e.g. an attached result asset); it is
#            copied in first so tiles it already holds are not predicted again
#   box [ASSET] [LO] [HI] [WEIGHTS] [WORKERS] [SKELETONIZE] [SCALING]
#            segment the box LO..HI (x,y,z um, as in SWCs) and (SKELETONIZE=yes, default) skeletonize
#            it block by block with the default and relaxed cleanup; SCALING=offset,scale fixes the
#            intensity normalization (slabs of one volume); results in /results/<subject>_box/
#   snr [URL] [N] [BLOCK_UM] [RESAMPLE] [LEVEL] [WEIGHTS] [CENTRES] [SEED]
#            axon SNR in N random tissue blocks of an OME-Zarr tile (TRAILMAP as the detector), native
#            and resampled to RESAMPLE (z,y,x um; 'none' = native only); CENTRES = a snr_blocks.json
#            in code/snr/ to score the same places (e.g. the 5x of a 1x run); SEED picks the random
#            blocks when no CENTRES are given; results in /results/snr/
#   snrpair [URL_A] [URL_B] [AFFINE] [N] [SEED] [WEIGHTS] [RAW_ROOT] [STITCHING]
#            axon SNR at the same places in two acquisitions (a = 1x tile, b = 5x fused); AFFINE = a
#            json in code/snr/ with p_b = A p_a + t; RAW_ROOT + STITCHING (xml in code/snr/) read b
#            from its raw tiles as well ('none' = fused only); results in /results/snr_pair/
#   finetune1x [STEPS] [MAX_MINUTES] [N_CUBES] [START_WEIGHTS]
#            fine-tune for 1x data (20 x 15 x 15 um voxels): 822178 MD lobe and the N_CUBES most
#            traced 794495 cubes, level 2 averaged 5x5x5, with the 1x blur/contrast/noise of
#            code/train/degradation_1x.json added to every patch; starts from START_WEIGHTS
#            (default the v2 weights); then scores it on 30 same-day 791116 1x/5x patch pairs
#            (5x segmented with the start weights); results in /results/finetune1x/, /results/snr_pair/
#   image [URL] [LO] [HI] [WEIGHTS] [PRECISION] [CHECK_TILES] [SAMPLE_SKIPPED] [MASK_LEVEL]
#            segment the box LO..HI (x,y,z um) of any OME-Zarr image (e.g. a raw 1x tile) at level 0
#            where it holds bright structure (tissue/signal mask from MASK_LEVEL, default 3);
#            optional precision check vs fp32 and a sample of skipped tiles; results in
#            /results/image/ (probability.zarr, report.json)
#   slabs [WORKERS] [RELAXED]
#            skeletonize every attached */probability.zarr (slabs from box runs, as data assets) as
#            one volume, block by block; results in /results/slabs_skeleton/
MODE="predict"
if [[ "${1:-}" =~ ^(predict|finetune|finetune1x|somata|expand|box|slabs|snr|snrpair|image)$ ]]; then MODE="$1"; shift; fi

ASSET="${1:-s3://aind-open-data/exaSPIM_851474_2026-07-10_15-23-22_processed_2026-07-21_13-59-36}"
REGIONS="${2:-MD}"
LEVEL="${3:-2}"
CROP_UM="${4:-0}"
TILE_SIZE="${5:-160}"
BATCH_SIZE="${6:-1}"

CODE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RESULTS=/results
export PATH="/opt/axon-venv/bin:${PATH}" XDG_CACHE_HOME=/opt/cache HF_HOME=/opt/hf-cache HF_HUB_OFFLINE=1

# The package is vendored at an exact commit; its dependencies are already in the image.
uv pip install --python /opt/axon-venv/bin/python --no-deps --no-cache --quiet \
    "${CODE_DIR}/exaspim-axon-segmentation"

mkdir -p "${RESULTS}/qc"
cp "${CODE_DIR}/exaspim-axon-segmentation/SOURCE_COMMIT" "${RESULTS}/"
uv pip list --python /opt/axon-venv/bin/python > "${RESULTS}/pip_list.txt"
nvidia-smi > "${RESULTS}/nvidia_smi.txt" 2>&1 || echo "nvidia-smi unavailable" > "${RESULTS}/nvidia_smi.txt"

if [[ "${MODE}" == "expand" ]]; then
    ASSET="${1:?asset root required}"
    MAX_ROUNDS="${2:-40}"
    MAX_MINUTES="${3:-600}"
    BUDGET_MM="${4:-100}"
    ANNOTATION="${5:-}"
    WEIGHTS="${6:-/data/trailmap_finetune_v2/best.safetensors}"
    subject="$(basename "${ASSET%/}" | cut -d_ -f2)"
    extra=()
    TRACER="${7:-/data/robo_ls_v2_ckpt/best.pt}"
    SEED="${8:-}"
    if [[ -n "${SEED}" ]]; then
        mkdir -p "${RESULTS}/${subject}_expand"
        echo "=== expand · seeding predictions from ${SEED}"
        cp -r "${SEED}" "${RESULTS}/${subject}_expand/probability.zarr"
    fi
    if [[ -n "${ANNOTATION}" ]]; then extra=(--annotation-asset "${ANNOTATION}"); fi
    if [[ "${TRACER}" != "none" && -f "${TRACER}" ]]; then extra+=(--tracer "${TRACER}"); fi
    echo "=== expand · tracer ${TRACER}"
    echo "=== expand · ${ASSET} · ${MAX_ROUNDS} rounds / ${MAX_MINUTES} min · ${BUDGET_MM} mm"
    exaspim-axon -v expand "${ASSET}" -r MD --out "${RESULTS}/${subject}_expand" \
        --weights "${WEIGHTS}" --budget-mm "${BUDGET_MM}" --max-rounds "${MAX_ROUNDS}" \
        --max-minutes "${MAX_MINUTES}" --batch-size 1 --device cuda "${extra[@]}" \
        2>&1 | tee "${RESULTS}/expand.log"
    exit 0
fi

if [[ "${MODE}" == "box" ]]; then
    ASSET="${1:?asset root required}"
    LO="${2:?box corner x,y,z required}"
    HI="${3:?box corner x,y,z required}"
    WEIGHTS="${4:-/data/trailmap_finetune_v2/best.safetensors}"
    WORKERS="${5:-6}"
    SKELETONIZE="${6:-yes}"
    SCALING="${7:-}"
    scaling=(); [[ -n "${SCALING}" ]] && scaling=(--scaling "${SCALING}")
    subject="$(basename "${ASSET%/}" | cut -d_ -f2)"
    out="${RESULTS}/${subject}_box"
    mkdir -p "${out}"
    echo "=== box · ${ASSET} · ${LO} .. ${HI} · ${WORKERS} workers"
    nproc; free -g || true
    start=$(date +%s)
    exaspim-axon -v predict-box "${ASSET}" --lo "${LO}" --hi "${HI}" --out "${out}/probability.zarr" \
        --weights "${WEIGHTS}" --batch-size 1 --device cuda "${scaling[@]}" 2>&1 | tee "${RESULTS}/box_predict.log"
    echo "=== predict took $(( $(date +%s) - start )) s"
    if [[ "${SKELETONIZE}" != "yes" ]]; then exit 0; fi
    for cleanup in default relaxed; do
        flag=(); [[ "${cleanup}" == "relaxed" ]] && flag=(--relaxed)
        t=$(date +%s)
        exaspim-axon -v skeletonize-blocks "${out}/probability.zarr" \
            --out "${out}/skeleton_${cleanup}" --workers "${WORKERS}" --min-swc-um 100 "${flag[@]}" \
            2>&1 | tee "${RESULTS}/box_skeleton_${cleanup}.log"
        echo "=== skeleton (${cleanup}) took $(( $(date +%s) - t )) s"
    done
    exit 0
fi

if [[ "${MODE}" == "finetune1x" ]]; then
    STEPS="${1:-4000}"
    MAX_MINUTES="${2:-40}"
    N_CUBES="${3:-40}"
    START="${4:-/data/trailmap_finetune_v2/best.safetensors}"
    SCRATCH="$(mktemp -d)"
    echo "=== finetune1x · ${STEPS} steps / ${MAX_MINUTES} min · ${N_CUBES} cubes · from ${START}"
    exaspim-axon -v make-coarse-volumes \
        s3://aind-open-data/exaSPIM_822178_2026-04-03_19-07-07_processed_2026-04-16_13-16-45 -r MD \
        --swc "${CODE_DIR}/traces/822178/N003-822178-JM.swc" \
        --swc "${CODE_DIR}/traces/822178/Neuron2_snapped_0.748um.swc" \
        --envelope-um 50 --out "${SCRATCH}/coarse" 2>&1 | tee "${RESULTS}/make_coarse_822178.log"
    exaspim-axon -v make-coarse-volumes \
        s3://aind-open-data/exaSPIM_794495_2026-01-21_14-25-07_processed_2026-07-28_08-24-11 \
        --points "${CODE_DIR}/traces/794495/points_4um.npz" --n-cubes "${N_CUBES}" \
        --out "${SCRATCH}/coarse/794495" 2>&1 | tee "${RESULTS}/make_coarse_794495.log"
    volumes=()
    for v in "${SCRATCH}"/coarse/*_lobe "${SCRATCH}"/coarse/794495/cube_*; do volumes+=(--volume "${v}"); done
    exaspim-axon -v finetune "${volumes[@]}" --out "${RESULTS}/finetune1x" --weights "${START}" \
        --degradation "${CODE_DIR}/train/degradation_1x.json" --steps "${STEPS}" \
        --max-minutes "${MAX_MINUTES}" --device cuda 2>&1 | tee "${RESULTS}/finetune1x.log"
    exaspim-axon -v snr-pair \
        s3://aind-open-data/791116_2026-06-09_12-58-40/SPIM/tile_000001_ch_561.ome.zarr \
        s3://aind-open-data/exaSPIM_791116_2026-06-09_16-31-33_processed_2026-06-16_12-28-34/fusion/fused.zarr \
        --affine "${CODE_DIR}/snr/791116_0609_1x_to_5x.json" --out "${RESULTS}/snr_pair" \
        --weights "${START}" --weights-a "${RESULTS}/finetune1x/best.safetensors" --n-blocks 30 --seed 0 \
        --raw-tiles s3://aind-open-data/exaSPIM_791116_2026-06-09_16-31-33/SPIM.ome.zarr \
        --stitching "${CODE_DIR}/snr/791116_5x_bigstitcher_affine.xml" --device cuda \
        2>&1 | tee "${RESULTS}/snr_pair.log"
    exit 0
fi

if [[ "${MODE}" == "image" ]]; then
    URL="${1:?OME-Zarr image URL required}"
    LO="${2:?box corner x,y,z required}"
    HI="${3:?box corner x,y,z required}"
    WEIGHTS="${4:-/data/trailmap_finetune_v2/best.safetensors}"
    PRECISION="${5:-bf16}"
    CHECK="${6:-20}"
    SAMPLE="${7:-50}"
    MASK_LEVEL="${8:-3}"
    echo "=== image · ${URL} · ${LO} .. ${HI} · ${PRECISION}"
    exaspim-axon -v predict-image "${URL}" "${LO}" "${HI}" --out "${RESULTS}/image" \
        --weights "${WEIGHTS}" --precision "${PRECISION}" --check-tiles "${CHECK}" \
        --sample-skipped "${SAMPLE}" --mask-level "${MASK_LEVEL}" --device cuda \
        2>&1 | tee "${RESULTS}/image.log"
    exit 0
fi

if [[ "${MODE}" == "snrpair" ]]; then
    URL_A="${1:?acquisition a URL required}"
    URL_B="${2:?acquisition b URL required}"
    AFFINE="${3:-791116_0609_1x_to_5x.json}"
    N="${4:-20}"
    SEED="${5:-0}"
    WEIGHTS="${6:-/data/trailmap_finetune_v2/best.safetensors}"
    RAW_ROOT="${7:-none}"
    STITCHING="${8:-791116_5x_bigstitcher_affine.xml}"
    raw=(); [[ "${RAW_ROOT}" != "none" ]] && raw=(--raw-tiles "${RAW_ROOT}" --stitching "${CODE_DIR}/snr/${STITCHING}")
    echo "=== snrpair · ${URL_A} -> ${URL_B} · ${N} blocks · seed ${SEED}"
    exaspim-axon -v snr-pair "${URL_A}" "${URL_B}" --affine "${CODE_DIR}/snr/${AFFINE}" --out "${RESULTS}/snr_pair" \
        --weights "${WEIGHTS}" --n-blocks "${N}" --seed "${SEED}" --device cuda \
        "${raw[@]}" 2>&1 | tee "${RESULTS}/snr_pair.log"
    exit 0
fi

if [[ "${MODE}" == "snr" ]]; then
    URL="${1:?OME-Zarr tile URL required}"
    N="${2:-20}"
    BLOCK_UM="${3:-1280,1440,1440}"
    RESAMPLE="${4:-4,2.992,2.992}"
    LEVEL="${5:-0}"
    WEIGHTS="${6:-/data/trailmap_finetune_v2/best.safetensors}"
    CENTRES="${7:-}"
    SEED="${8:-0}"
    extra=(--seed "${SEED}"); [[ -n "${CENTRES}" ]] && extra+=(--centres "${CODE_DIR}/snr/${CENTRES}")
    echo "=== snr · ${URL} · ${N} blocks of ${BLOCK_UM} um · level ${LEVEL} · resample ${RESAMPLE}"
    exaspim-axon -v snr-blocks "${URL}" --out "${RESULTS}/snr" --weights "${WEIGHTS}" --n-blocks "${N}" \
        --block-um "${BLOCK_UM}" --resample-um "${RESAMPLE}" --level "${LEVEL}" --device cuda \
        "${extra[@]}" 2>&1 | tee "${RESULTS}/snr.log"
    exit 0
fi

if [[ "${MODE}" == "slabs" ]]; then
    WORKERS="${1:-6}"
    RELAXED="${2:-no}"
    mapfile -t slabs < <(find /data -maxdepth 4 -type d -name probability.zarr | sort)
    echo "=== slabs · ${#slabs[@]} predictions: ${slabs[*]}"
    nproc; free -g || true
    flag=(); [[ "${RELAXED}" == "yes" ]] && flag=(--relaxed)
    exaspim-axon -v skeletonize-slabs "${slabs[@]}" --out "${RESULTS}/slabs_skeleton" \
        --workers "${WORKERS}" "${flag[@]}" 2>&1 | tee "${RESULTS}/slabs.log"
    exit 0
fi

if [[ "${MODE}" == "somata" ]]; then
    ASSET="${1:?asset root required}"
    SOMATA="${CODE_DIR}/somata/${2:?somata list name required}.csv"
    SIDE_UM="${3:-1200}"
    WEIGHTS="${4:-/data/trailmap_finetune_v2/best.safetensors}"
    echo "=== somata · ${ASSET} · $(($(wc -l < "${SOMATA}") - 1)) cubes of ${SIDE_UM} um · ${WEIGHTS}"
    exaspim-axon -v predict-somata "${ASSET}" --somata "${SOMATA}" --side-um "${SIDE_UM}" \
        --out "${RESULTS}" --weights "${WEIGHTS}" --batch-size 1 --device cuda \
        2>&1 | tee "${RESULTS}/somata.log"
    exit 0
fi

if [[ "${MODE}" == "finetune" ]]; then
    STEPS="${1:-4000}"
    MAX_MINUTES="${2:-40}"
    HOLDOUT="${3:-744783}"
    ENVELOPE_UM="${4:-50}"
    TRAIN_ASSET="s3://aind-open-data/exaSPIM_822178_2026-04-03_19-07-07_processed_2026-04-16_13-16-45"
    BLOCKS="gs://allen-nd-goog/from_aind/training-data_2025-07-30"
    SCRATCH="$(mktemp -d)"
    echo "=== finetune · ${STEPS} steps / ${MAX_MINUTES} min · holdout brain ${HOLDOUT} · envelope ${ENVELOPE_UM} um"
    exaspim-axon -v make-labels "${TRAIN_ASSET}" -r MD \
        --swc "${CODE_DIR}/traces/822178/N003-822178-JM.swc" \
        --swc "${CODE_DIR}/traces/822178/Neuron2_snapped_0.748um.swc" \
        --envelope-um "${ENVELOPE_UM}" --out "${SCRATCH}/822178_MD_L2" \
        2>&1 | tee "${RESULTS}/make_labels.log"
    exaspim-axon -v make-block-volumes "${BLOCKS}" --out "${SCRATCH}/blocks" \
        2>&1 | tee "${RESULTS}/make_block_volumes.log"
    volumes=(--volume "${SCRATCH}/822178_MD_L2")
    for block in "${SCRATCH}"/blocks/block_*; do volumes+=(--volume "${block}"); done
    exaspim-axon -v finetune "${volumes[@]}" --out "${RESULTS}/finetune" --holdout-brain "${HOLDOUT}" \
        --steps "${STEPS}" --max-minutes "${MAX_MINUTES}" --device cuda \
        2>&1 | tee "${RESULTS}/finetune.log"
    WEIGHTS="${RESULTS}/finetune/best.safetensors"
    # Evaluate on the unseen brain used before: full MD of 851474 with the fine-tuned weights.
    ASSET="s3://aind-open-data/exaSPIM_851474_2026-07-10_15-23-22_processed_2026-07-21_13-59-36"
    REGIONS="MD"; LEVEL="2"; CROP_UM="0"; TILE_SIZE="160"; BATCH_SIZE="1"; REGION_GROWTH="0.2"
else
    WEIGHTS="${7:-/data/trailmap_finetune_v2/best.safetensors}"
    REGION_GROWTH="${8:-0.2}"
    ANNOTATION="${9:-}"
    if [[ "${WEIGHTS}" == /* && ! -f "${WEIGHTS}" ]]; then
        echo "Weights ${WEIGHTS} not found: attach the fine-tuned model data asset" >&2
        exit 1
    fi
fi

subject="$(basename "${ASSET%/}" | cut -d_ -f2)"
tag="${subject}_${REGIONS//,/+}_L${LEVEL}"
region_args=()
IFS=, read -ra region_list <<< "${REGIONS}"
for region in "${region_list[@]}"; do region_args+=(-r "${region}"); done
annotation_args=()
if [[ -n "${ANNOTATION:-}" ]]; then annotation_args=(--annotation-asset "${ANNOTATION}"); fi
crop_args=()
if [[ "${CROP_UM}" != "0" ]]; then
    crop_args=(--crop-um "${CROP_UM}")
    tag="${tag}_crop${CROP_UM}"
fi

echo "=== ${ASSET} · regions ${REGIONS} (+${REGION_GROWTH} volume) · level ${LEVEL} · weights ${WEIGHTS}"
exaspim-axon -v qc-region "${ASSET}" "${region_args[@]}" "${annotation_args[@]}" \
    --out "${RESULTS}/qc/${tag}_region_overlay.png"
exaspim-axon -v run "${ASSET}" "${region_args[@]}" --out "${RESULTS}" --weights "${WEIGHTS}" \
    --level "${LEVEL}" --tile-size "${TILE_SIZE}" --batch-size "${BATCH_SIZE}" --device cuda \
    --region-growth "${REGION_GROWTH}" "${crop_args[@]}" "${annotation_args[@]}" \
    2>&1 | tee "${RESULTS}/run.log"
echo "=== done: ${RESULTS}/${tag}_skeleton/swc"
